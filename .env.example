# 运行环境示例：复制成 .env.local（本机）或 .env.production.local（线上覆盖）后按需修改。
# 本文件会被提交，只放地址，不要放 API Key、数据库密码等秘密；这些留在后端。

# ---- 环境名 ----
# development 用本地地址；production 用 chat./api. 域名。
# 通常不用写：pnpm dev 是 development，pnpm build 是 production。
APP_ENV=development

# ---- 开发环境（pnpm dev）----
# 前端站点地址
WEB_ORIGIN=http://localhost:8090
# devServer 端口
DEV_PORT=8090
# 本地开发启用 HTTPS（自签证书，首次访问需在浏览器信任）；启用后 WEB_ORIGIN 同步改成 https://localhost:8090
# 注意：`npm run dev` 已通过 `--env DEV_HTTPS=true` 强制开启 HTTPS，无需再改这里；此项供其他命令或关闭需求使用
DEV_HTTPS=false
# 本地后端地址：/auth、/v1、/api 都代理到它
DEV_API_TARGET=https://127.0.0.1:3000

# ---- 生产环境（pnpm build）----
# 前端生产域名
WEB_ORIGIN=https://chat.shunkai-dg.cn
# 后端生产域名
API_ORIGIN=https://api.shunkai-dg.cn

# ---- 生产环境（pnpm build）----
# 接口前缀：写完整地址=跨域直连 api 域名；写 /auth、/v1=同源，由前端 Nginx 反代
AUTH_BASE=/auth
BFF_BASE=/v1
# 跨域带凭证（include）/ 同源（same-origin）。留空则按前后缀是否跨域自动决定。
API_CREDENTIALS=same-origin
# 部署子目录，如 /app/；根目录部署保持 /
BASE_PATH=/
